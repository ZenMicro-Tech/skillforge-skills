{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "enum": ["s3", "ec2", "sts", "iam"],
      "description": "AWS service to call."
    },
    "operation": {
      "type": "string",
      "description": "Read-only operation name in kebab-case (e.g. list-buckets)."
    },
    "args": {
      "type": "object",
      "description": "Operation-specific arguments. See prompt.md for shapes.",
      "additionalProperties": true
    }
  },
  "required": ["service", "operation"],
  "additionalProperties": false
}
